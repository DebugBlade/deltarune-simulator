;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Deltarune Simulator"
run/main_scene="uid://bqye07crvblhg"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Global="*uid://bi1dsd1u0hqoq"
SoundManager="*uid://bbd1q6i64wqhu"

[debug]

